<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="44sp"
        android:textStyle="bold"
        android:textColor="@color/accent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/library_subtitle"
        android:textSize="18sp"
        android:textColor="@color/text_dim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_add_games"
            style="@style/AeonButton"
            android:text="@string/add_games" />

        <Button
            android:id="@+id/btn_bios"
            style="@style/AeonButton"
            android:layout_marginStart="16dp"
            android:text="@string/bios" />

        <Button
            android:id="@+id/btn_settings"
            style="@style/AeonButton"
            android:layout_marginStart="16dp"
            android:text="@string/settings" />
    </LinearLayout>

    <TextView
        android:id="@+id/empty_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:text="@string/no_games"
        android:textSize="22sp"
        android:textColor="@color/text_dim" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/game_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="24dp"
        android:clipToPadding="false"
        android:padding="8dp" />
</LinearLayout>
