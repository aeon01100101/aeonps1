<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="44sp"
        android:textStyle="bold"
        android:textColor="@color/accent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/library_subtitle"
        android:textSize="18sp"
        android:textColor="@color/text_dim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btn_browse_files"
            style="@style/AeonButton"
            android:minWidth="300dp"
            android:minHeight="80dp"
            android:textSize="24sp"
            android:text="@string/browse_files" />

        <Button
            android:id="@+id/btn_add_games"
            style="@style/AeonButton"
            android:layout_marginStart="16dp"
            android:text="@string/add_games" />

        <Button
            android:id="@+id/btn_bios"
            style="@style/AeonButton"
            android:layout_marginStart="16dp"
            android:text="@string/bios" />

        <Button
            android:id="@+id/btn_settings"
            style="@style/AeonButton"
            android:layout_marginStart="16dp"
            android:text="@string/settings" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/grant_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone"
        android:background="@drawable/card_bg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grant_text"
            android:textSize="20sp"
            android:textColor="@color/text" />

        <Button
            android:id="@+id/btn_grant"
            style="@style/AeonButton"
            android:layout_marginTop="12dp"
            android:text="@string/grant_button" />
    </LinearLayout>

    <TextView
        android:id="@+id/empty_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:text="@string/no_games"
        android:textSize="22sp"
        android:textColor="@color/text_dim" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/game_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="24dp"
        android:clipToPadding="false"
        android:padding="8dp" />
</LinearLayout>
